            "Step number": 3,
            "Action": "Surface finishing",
            "Equipment": ["Laser cutter"],
            "Significance": {
                "Length": 13.5,
                "Width": 13.5,
                "Height/thickness": 9.5,
                "Weight": 18.5
            },
            "Additional notes": "Use of laser for precise and clean cuts."
        }
    ]
}

